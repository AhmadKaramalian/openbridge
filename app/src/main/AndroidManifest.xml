<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============= PERMISSIONS ============= -->
    <!-- Telephony - for bridging calls/SMS to iPhone -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Contacts (READ-ONLY — we do NOT request WRITE_CONTACTS) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Bluetooth LE (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock for call continuity -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Call companion (low-latency call notification) -->
    <uses-permission android:name="android.permission.CALL_COMPANION_APP" />

    <!-- ============= PERMISSIONS WE EXPLICITLY DO NOT REQUEST =============
        NOTE: Compared to similar apps, OpenBridge does NOT request:

        * android.permission.INTERNET                  — no network access
        * android.permission.ACCESS_NETWORK_STATE     — no network operations
        * android.permission.WRITE_CONTACTS           — contacts are read-only
        * android.permission.WRITE_SECURE_SETTINGS    — no system settings changes
        * android.permission.ACCESS_FINE_LOCATION     — not needed for BLE on Android 13+
        * android.permission.RECEIVE_BOOT_COMPLETED   — autostart is opt-in per session
        * android.permission.CHANGE_WIFI_STATE        — no WiFi manipulation
        * android.permission.READ_EXTERNAL_STORAGE    — no file access
        * android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS — user manages this

        This is by design. See docs/PRIVACY.md for justification.
    =================================================================== -->

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".OpenBridgeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenBridge"
        tools:targetApi="34">

        <!-- Main activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpenBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bridge service (foreground) -->
        <service
            android:name=".bridge.BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- InCallService (optional, user can toggle) -->
        <service
            android:name=".call.OpenBridgeInCallService"
            android:exported="false"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- SMS receiver -->
        <receiver
            android:name=".telephony.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
